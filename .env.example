# ── Variables de Entorno — NAD Constructora ───────────────────────────────────
# Copiá este archivo como .env y completá los valores para tu entorno.

# Puerto del servidor (default: 3000)
PORT=3000

# Ruta secreta del panel admin (cambiar en producción)
ADMIN_PATH=gestion-nad-2026

# Contraseña inicial del admin (solo se usa al crear la DB por primera vez)
ADMIN_DEFAULT_PASS=nad2026

# Secreto para firmar las cookies de sesión (CAMBIAR en producción)
SESSION_SECRET=cambiar-este-secreto-en-produccion

# Entorno (development | production)
NODE_ENV=development

# Forzar cookie segura (se activa automáticamente con NODE_ENV=production)
# COOKIE_SECURE=true

# Directorios de datos (Railway usa volúmenes persistentes)
# DATA_DIR=/path/to/data
# UPLOADS_DIR=/path/to/uploads
